# Publish staging tree. Built by the maintainer's publish tooling, which copies
# the source folder here with scrubs applied before anything is committed.
# Regenerated from scratch on every run -- never commit it.
_publish-staging/

# Python bytecode
__pycache__/
*.py[cod]

# Python build residue. pyproject.toml makes `pip install .` possible in this
# tree, and that writes build/ and <name>.egg-info/ next to it.
build/
*.egg-info/

# Editor / OS noise
.DS_Store
Thumbs.db

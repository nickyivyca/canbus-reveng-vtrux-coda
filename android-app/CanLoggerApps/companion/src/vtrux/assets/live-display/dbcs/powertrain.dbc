CM_ BO_ 84 "Via Motors GENE (generator) MCU.";
CM_ SG_ 84 GENE_RotSpd "Zero at raw=32767 (0x7FFF). Note: GENE uses 32767, not 32768 like trac_rpm.";
CM_ BO_ 1040 "A123 BMS status message. bcm_mainc_stat and bcm_chgc_stat share the OPEN/CLOSED/HIGH/LOW array. bcm_alarm is a 4-entry NONE/TYPE1/TYPE2/TYPE3 array from B1[7:6].";
CM_ SG_ 1040 bcm_gfd "Ground fault detection (isolation monitor). Normal=1000.0 (raw=4000). Fault=0.0 (raw=0) -- fires 150ms before EPO in isolation test; does not fire in charge fault EPO or normal drives.";
CM_ SG_ 1040 bcm_ibat "Negative=discharge, positive=charge. Zero at raw=40000. Invalid if (raw & 0xFFFE)==0xFFFE.";
CM_ SG_ 1040 bcm_mainc_stat "Shares array with bcm_chgc_stat.";
CM_ SG_ 1040 bcm_chgc_stat "Shares array with bcm_mainc_stat.";
VAL_ 1040 bcm_alarm 0 "NONE" 1 "TYPE1" 2 "TYPE2" 3 "TYPE3" ;
VAL_ 1040 bcm_chgc_stat 0 "OPEN" 1 "CLOSED" 2 "HIGH" 3 "LOW" ;
VAL_ 1040 bcm_mainc_stat 0 "OPEN" 1 "CLOSED" 2 "HIGH" 3 "LOW" ;
CM_ BO_ 1056 "A123 BMS charge/discharge current limits. bcm_cell_overvolt/undervolt are boolean flags from B6.";
CM_ BO_ 1072 "A123 BMS cell data. Voltage sentinel 0x1FFE (8.190V) falls inside declared range -- EPRI uses explicit equality checks, not range filtering. Temperature sentinel raw>=0xFE excluded by DBC range. bcm_lvbat B7[6:5]=0x60 when 12V falls below 12.8V (BMS offline) -- BMS_ValidityMux byproduct, not a dedicated flag.";
CM_ SG_ 1072 bcm_cell_vmax "Sentinel raw=0x1FFE (8.190V) excluded by DBC range -- healthy LFP cells stay below 3.8V.";
CM_ SG_ 1072 bcm_cell_tmax "Sentinel raw>=0xFE excluded by DBC range. Supersedes prior experimental formula raw-100.";
CM_ SG_ 1072 bcm_lvbat "Typical: 14.0V (DCDC running), 12.7V (at rest/shutdown).";
CM_ BO_ 1088 "A123 BMS balancing state and HV bus voltages. bcm_mainc_stat here is 4-bit (16-entry contactor state machine) -- distinct from 2-bit bcm_mainc_stat in 0x0410.";
CM_ SG_ 1088 bcm_mainc_stat "16-entry contactor sequence state machine. See VAL_.";
CM_ SG_ 1088 bcm_fgd "Role unconfirmed (plist label only). Always at sentinel 0xFE in all 73 captured logs -- never populated by this BMS configuration.";
CM_ SG_ 1088 bcm_vbus_neg "Zero at raw=2000.";
VAL_ 1088 bcm_mainc_stat 0 "ALL_OPEN" 1 "FAILED_MAINP_OR_R_WELD" 2 "CLOSE_MAINR" 3 "FAILED_MAINR_OPEN" 4 "FAILED_MAINN_WELD" 5 "CLOSE_MAINN" 6 "FAILED_MAINN_OPEN" 7 "WAIT_PRECHARGE" 8 "CLOSE_MAINP" 9 "OPEN_MAINR" 10 "FAILED_MAINP_OPEN" 11 "MAIN_PN_CLOSED_DRIVE" 12 "MAIN_P_CLOSED_CHARGE" 13 "SHUTDOWN_REQUEST" 14 "ALL_OPEN_SHUTDOWN" ;
CM_ BO_ 1137 "Via Motors GENE MCU motor torque. B2-B6 uncharacterized.";
CM_ SG_ 1137 GENE_Mot_Trq "Zero at raw=32768. Offset -4096 Nm.";
CM_ BO_ 1145 "Via Motors GENE MCU thermal status.";
CM_ BO_ 1145 "B3 uncharacterized.";
CM_ BO_ 2566903475 "Separate DC-DC step-down converter (NOT the Bel INVCH unit). Not in BelInverter.dbc.";
CM_ BO_ 1609 "VCU/VCM evap canister purge control. 0x649 on PT bus, ~20 Hz, VCU-sourced. Full message encoding differs between drive and charge modes -- byte fields repurpose themselves; B0 values cannot be compared across modes. See notes/evap-cycle-analysis.md Phase 2D for full investigation.";
CM_ SG_ 1609 vcm_evap_active "1 = evap purge in progress; clears ~6.1s before VCM commands generator stop. Holds through involuntary stalls; only clears on VCM-declared completion. Lower 7 bits unresolved -- may encode canister load or session context.";
CM_ BO_ 2566903232 "(SA=0xC0). Bel inverter/charger temperatures. EPRI app: INVCH_Bdc_Temp. B0:B3 from previous DBC only. Note: EPRI identifies B4:B5 as BDC internal temperature, not ambient. overallTemperaturePercent corrected to 8-bit (B6 only); previous DBC had 16-bit.";

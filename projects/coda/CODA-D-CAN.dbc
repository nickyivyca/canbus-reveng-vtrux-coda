CM_ BO_ 82 "Parking brake.";
CM_ BO_ 128 "Steering angle sensor. CRC8-protected at B7.";
CM_ SG_ 128 SteeringAngle "CRC8-protected.";
CM_ BO_ 448 "MCM telemetry forwarded by DLCM from private Motor CAN sub-bus.";
CM_ SG_ 448 Torque "Regen shows negative values.";
CM_ SG_ 448 HV_Voltage "~335V at mid-SoC LFP pack.";
CM_ SG_ 448 HV_Current "Positive=discharge.";
CM_ SG_ 448 Motor_Speed "Positive=forward.";
CM_ BO_ 512 "ESC front wheel speed message. Multiplexed by B0 (SubFrameID): 0x00=primary wheel speeds (200 Hz); 0x0A/0x0B=startup frames; 0x20=TC event frame (content unknown); 0x14=ABS fault state. Zero encoding 0xC000. Scale TBD.";
CM_ SG_ 512 SubFrameID "B0 sub-frame selector. 0x00=primary wheel speeds (DBC mux gate). 0x0A/0x0B=startup transition frames. 0x20=TC event frame (content unknown). 0x14=parts car ABS fault (same wheel speed layout as 0x00). Non-0x00 frames do NOT contain valid wheel speeds.";
CM_ SG_ 512 WheelSpeed_RollingCounter "B1 rolling counter 0-125, valid only in SubFrameID=0x00 sub-frames.";
CM_ SG_ 512 WheelSpeed_LF "Zero=0xC000. Valid only in SubFrameID=0x00. Outer wheel in right turns. Spikes during FWD TC events. Scale TBD.";
CM_ SG_ 512 WheelSpeed_RF "Zero=0xC000. Valid only in SubFrameID=0x00. Inner wheel in right turns. Spikes during FWD TC events. Scale TBD.";
CM_ SG_ 512 WheelSpeed_LF_secondary "Identical to WheelSpeed_LF (B6-B7) -- same physical sensor, redundant broadcast.";
CM_ BO_ 520 "ESC module. B4-B5=WheelSpeed_RR, B6-B7=WheelSpeed_LR (corrected from prior FL/FR hypothesis).";
CM_ SG_ 520 BrakePressure "Engages ~40ms after brake switch.";
CM_ SG_ 520 ESPSysSts "B1 bit 5. Active (0x20) when ESC on, 0x00 at key-off.";
CM_ SG_ 520 WheelSpeed_RR "Zero=0xC000. Non-driven axle (does not spike during FWD TC events). C102B DTC 'Right Rear Wheel Speed Sensor Circuit' -- parts car confirms by stuck-at-0xFFFF fault sentinel. Scale TBD.";
CM_ SG_ 520 WheelSpeed_LR "Zero=0xC000. Non-driven axle. Tracks vehicle reference speed. Scale TBD.";
CM_ BO_ 528 "Vehicle mode / throttle. 50 Hz.";
CM_ BO_ 530 "DLCM Torque Request message (NOT steering angle -- VICD originally tagged EPS_SAM_1). Two alternating sub-frames at 25 Hz each (50 Hz total). Also carries TorqueRequest and KeepWakeNetworkDLCM per CODACAN, byte positions unconfirmed.";
CM_ SG_ 530 BrakeSW "Triple-redundancy: same signal at 0x315 B0.bit0 and 0x200 B1.bit0.";
CM_ BO_ 533 "VICD: misc_Recvd 0x215. Candidate: TCM.ParkLock? 16-bit word, 1/128 scale.";
CM_ BO_ 576 "System power mode. B0: 0x11=key-on (HV off), 0x01=Ready (HV on). Medium confidence. D+B CAN (gateway rebroadcast). DLC unconfirmed. See notes/driver-inputs.md.";
CM_ BO_ 584 "Exterior lights state. B1.bit3=any exterior lights on (boolean). B6=possible instrument dimming (unconfirmed). Medium confidence. D+B CAN (gateway rebroadcast). DLC unconfirmed. See notes/driver-inputs.md.";
CM_ BO_ 577 "MCM motor thermal data relayed by DLCM from private Motor CAN sub-bus. Carries Rotor temp, Stator temp, IGBT temp per CODACAN DLCM tab. Encoding: probable offset -40 degC, per-byte assignment unconfirmed. NOTE: 8 bytes seen in log data -- DLC may be higher than 3, verify before use.";
CM_ BO_ 625 "VICD: misc_Recvd 0x271. Death Counter partial (integer bytes).";
CM_ BO_ 632 "DLCM Drive Keepalive. Carries KeepWakeNetworkDLCM and EngineStsRun per CODACAN. B1 bit 6 (mask 0x40) = HV/Drive Ready flag (medium confidence). Signal byte positions unconfirmed.";
CM_ BO_ 776 "BorgWarner TCM park pin state + input shaft speed. D CAN exclusive. Cross-vehicle match with Vtrux 0x308. B3-B4=constant 0x00. Same encoding as Motor_Speed (0x1C0 B6-B7).";
CM_ SG_ 776 ParkPinState "0x20=Park, 0x40=NotPark. Pin release leads GMLAN gear-change by ~13ms; pin lock lags by ~65ms (solenoid actuation delay).";
CM_ SG_ 776 InputShaftSpeed "Zero=0x7D80. Input shaft (not output): ratio to motor RPM = 2.000 on both Vtrux and Coda regardless of gear ratio.";
CM_ BO_ 789 "DLCM status. B0.bits2-7=rolling counter. B1,B3 zero when stationary.";
CM_ SG_ 789 Brake_SW "Engages ~40ms before hydraulic pressure.";
CM_ SG_ 789 Batt_Volt "Cross-check vs DCDC 14VMonitor (0x1D5).";
CM_ BO_ 805 "D CAN exclusive anchor ID. Never rebroadcast to B CAN. Signal content unknown.";
CM_ BO_ 816 "VICD: misc_Recvd 0x330. Long_Accel: signed byte, 0.08 m/s2/count.";
CM_ BO_ 880 "VICD: misc_Recvd 0x370. Death Counter batch (6 bytes used: B0-B4,B7, 0.1 scale).";
CM_ BO_ 1048 "DLCM globals. Active in both key-on and Ready states.";
CM_ SG_ 1048 PRND "ASCII-encoded: P=0x50, R=0x52, N=0x4E, D=0x44.";
CM_ SG_ 1048 GearStatus "B4 uint8. P=0xDD, R=0xBB, N=0x00, D=0x11. Intermediate values during shifts. Medium confidence.";
CM_ BO_ 1372 "BorgWarner TCM state heartbeat. 10 Hz. B0=TCMState enum (see VAL_). B1-B3=constant 0x00. Cross-vehicle: Coda and Vtrux share identical structure.";
CM_ SG_ 1372 TCMState "0x42=Steady Park, 0x04=Park releasing (~55ms after 0x308 pin release), 0x85=Drive/Manual, 0x01=Park engaging (~65ms after pin locks).";
CM_ BO_ 1408 "D CAN exclusive anchor ID. Never rebroadcast to B CAN. Signal content unknown.";
CM_ BO_ 1536 "VICD: misc_Recvd 0x600. Candidate: TPMS pressure (1.37 kPa/count). RCU on D CAN.";
CM_ BO_ 1786 "GWM rebroadcasts VIN on D CAN (same 0x6FA as B CAN). See B CAN DBC for full encoding.";
CM_ SG_ 1786 VIN_Frame "See B CAN DBC for full char layout.";

VAL_ 512 SubFrameID 0 "WheelSpeeds" 10 "Startup_0x0A" 11 "Startup_0x0B" 20 "ABSFault_0x14" 32 "TCEvent_0x20" ;
VAL_ 776 ParkPinState 32 "Park" 64 "NotPark" ;
VAL_ 1048 PRND 80 "P" 82 "R" 78 "N" 68 "D" ;
VAL_ 1372 TCMState 66 "SteadyPark" 4 "ParkReleasing" 133 "Drive" 1 "ParkEngaging" ;


VAL_ 2 InvOpmode 0 "Off" 1 "Run" 2 "ManualRun" 3 "Boost" 4 "Buck" 5 "Sine" 6 "AcHeat" ;
VAL_ 1537 SdoCmd 64 "Read" 67 "ReadReply" 35 "Write" 96 "WriteReply" 128 "Abort" ;
VAL_ 1409 SdoCmd 64 "Read" 67 "ReadReply" 35 "Write" 96 "WriteReply" 128 "Abort" ;
VAL_ 2 InvIo_Ocur 0 "Error" 1 "Ok" 2 "na" ;
VAL_ 2 InvIo_Desat 0 "Error" 1 "Ok" 2 "na" ;

CM_ "914 EV telemetry schema 4.2, SCHEMA_HASH=0x09EB175A. Generated by generate_914_dbc.py -- do not hand-edit.";


CM_ SG_ 1627 DTC_Code "16-bit SAE J2012 code (big-endian). 29-entry lookup -- see VAL_.";

CM_ BO_ 2566902976 "Bel Power Solutions INVCH_Bdc multi-page status. B0=page selector. Cross-validated against BelInverter.dbc (EPRI app missing 3 fault flags on page 3).";

CM_ SG_ 2566902976 INVCH_Bdc_Signal_State "Page 0. 29-entry state dictionary. See VAL_.";
CM_ SG_ 2566902976 INVCH_Bdc_bBoost_St "Page 1. 21-entry buck-boost state dictionary. See VAL_.";
CM_ SG_ 2566902976 INVCH_Bdc_Inverter_St "Page 2. 35-entry inverter state dictionary. See VAL_.";
CM_ SG_ 2566902976 INV_Bdc_bACOk "Also in BelInverter.dbc as BELINV_acOk.";
CM_ SG_ 2566902976 INV_Bdc_bACOV "AC over-voltage.";
CM_ SG_ 2566902976 INV_Bdc_bACUV "AC under-voltage.";
CM_ SG_ 2566902976 INV_Bdc_bBatteryUV "12V battery under-voltage.";
CM_ SG_ 2566902976 INV_Bdc_bHVBatteryOV "HV battery over-voltage.";
CM_ SG_ 2566902976 INV_Bdc_bHVBatteryUV "HV battery under-voltage.";
CM_ SG_ 2566902976 INV_Bdc_bOTP "Over-temperature protection.";
CM_ SG_ 2566902976 INV_Bdc_bExportOverload "Export overload.";

CM_ BO_ 84 "Via Motors GENE (generator) MCU.";

CM_ BO_ 1040 "A123 BMS status message. bcm_mainc_stat and bcm_chgc_stat share the OPEN/CLOSED/HIGH/LOW array. bcm_alarm is a 4-entry NONE/TYPE1/TYPE2/TYPE3 array from B1[7:6].";

CM_ BO_ 1056 "A123 BMS charge/discharge current limits. bcm_cell_overvolt/undervolt are boolean flags from B6.";

CM_ BO_ 1072 "A123 BMS cell data. Voltage sentinel 0x1FFE (8.190V) falls inside declared range -- EPRI uses explicit equality checks, not range filtering. Temperature sentinel raw>=0xFE excluded by DBC range. bcm_lvbat B7[6:5]=0x60 when 12V falls below 12.8V (BMS offline) -- BMS_ValidityMux byproduct, not a dedicated flag.";

CM_ BO_ 1088 "A123 BMS balancing state and HV bus voltages. bcm_mainc_stat here is 4-bit (16-entry contactor state machine) -- distinct from 2-bit bcm_mainc_stat in 0x0410.";

CM_ BO_ 1137 "Via Motors GENE MCU motor torque. B2-B6 uncharacterized.";

CM_ BO_ 1145 "Via Motors GENE MCU thermal status.";

CM_ BO_ 1154 "Via Motors GENE MCU HV bus current and voltage.";

CM_ BO_ 1426 "HCU sensor inputs. EVSESwitchState (B0 bit1), ExportPowerState (B0 bit2), IgnitionKeyState (B0 bit4) not in plist sampling. B6-B7 uncharacterized.";

CM_ BO_ 1432 "EPRI DECODE DEFECT: the app decodes B0-B1 and B4-B5 as plain signed int16 (zero at raw 0x0000), but the wire format is offset-binary excess-32768 (zero at raw 0x8000). SG_ entries removed per DBC signal policy. Corrected signals are in vtrux-powertrain-experimental.dbc, which also carries generator power at B2-B3. B6-B7 = static bias, not power data.";

CM_ BO_ 1433 "HCU motor cooling oil pressures. Note: plist index .1=traction, .2=generator (reversed from format string order). B2-B3 and B6-B7 uncharacterized.";

CM_ BO_ 1573 "HCU vehicle odometer and platform config. Scale 1 km/count (integer km). B4-B7 uncharacterized.";

CM_ BO_ 2566903232 "Bel Power Solutions inverter/charger -- BDC temperature. INVCH_Bdc = bidirectional DC stage.";

CM_ BO_ 2566903475 "Separate DC-DC step-down converter (NOT the Bel INVCH unit). Not in BelInverter.dbc.";

CM_ BO_ 2566903488 "Bel Power Solutions inverter -- AC output. INVCH_Inv = inverter sub-stage (DC->AC). Vout1/Vout2 = split-phase 120V/120V. Cross-validated against BelInverter.dbc.";

CM_ BO_ 2566903744 "Bel Power Solutions bidirectional charger -- HV battery and AC input. INVCH_Bdc_Ibat: signed (bidirectional); positive = charging, negative = discharging/export.";

CM_ BO_ 2566904000 "Bel Power Solutions -- 12V battery monitoring. Cross-validated against BelInverter.dbc.";


CM_ SG_ 84 GENE_RotSpd "Zero at raw=32767 (0x7FFF). Note: GENE uses 32767, not 32768 like trac_rpm.";

CM_ SG_ 1040 bcm_gfd "Ground fault detection (isolation monitor). Normal=1000.0 (raw=4000). Fault=0.0 (raw=0) -- fires 150ms before EPO in isolation test; does not fire in charge fault EPO or normal drives.";
CM_ SG_ 1040 bcm_ibat "Negative=discharge, positive=charge. Zero at raw=40000. Invalid if (raw & 0xFFFE)==0xFFFE.";
CM_ SG_ 1040 bcm_mainc_stat "Shares array with bcm_chgc_stat.";
CM_ SG_ 1040 bcm_chgc_stat "Shares array with bcm_mainc_stat.";


CM_ SG_ 1072 bcm_cell_vmax "Sentinel raw=0x1FFE (8.190V) excluded by DBC range -- healthy LFP cells stay below 3.8V.";
CM_ SG_ 1072 bcm_cell_tmax "Sentinel raw>=0xFE excluded by DBC range. Supersedes prior experimental formula raw-100.";
CM_ SG_ 1072 bcm_lvbat "Typical: 14.0V (DCDC running), 12.7V (at rest/shutdown).";

CM_ SG_ 1088 bcm_mainc_stat "16-entry contactor sequence state machine. See VAL_.";
CM_ SG_ 1088 bcm_fgd "Role unconfirmed (plist label only). Always at sentinel 0xFE in all 73 captured logs -- never populated by this BMS configuration.";
CM_ SG_ 1088 bcm_vbus_neg "Zero at raw=2000.";

CM_ SG_ 1137 GENE_Mot_Trq "Zero at raw=32768. Offset -4096 Nm.";

CM_ BO_ 1145 "B3 uncharacterized.";
CM_ BO_ 1154 "B5 uncharacterized.";

CM_ SG_ 1154 GENE_HighPwr_Curr "Zero at raw=8192. Byte-swapped (BE) alternative gives absurd values -- use Intel LE.";



CM_ SG_ 1573 VehicleOdometer "Scale 1 km/count (integer km). See projects/vtrux/README.md 'How to Tell the Two Trucks Apart'.";
CM_ SG_ 1573 VehicleConfig "0=K2XX (Silverado/Tahoe-based Vtrux), 1=GMT-600 (Express van Vtrux).";




CM_ SG_ 2566903744 INVCH_Bdc_Ibat "Positive=charging, negative=discharging/export.";


CM_ BO_ 83 "HCU operating mode and state machine.";

CM_ SG_ 83 OperationMode "0=NTRL; other values are error strings (app defect -- only 0 is a real mode).";
CM_ SG_ 83 OperationState "9-entry state machine, valid 0-8.";

CM_ BO_ 776 "HCU park request command. B1-B2=InputShaftSpeed decoded in vtrux-powertrain-experimental.dbc.";

CM_ SG_ 776 ParkRequest "0=OFF, 1=Park, 2=UnPark.";

CM_ BO_ 1024 "HV BCM control word (HCU-to-BMS commands).";

CM_ SG_ 1024 hsc_bcm_epo "Emergency power off command.";

CM_ BO_ 1372 "BorgWarner TCM state. See notes/borgwarner.md.";


CM_ BO_ 1408 "TCM CAN error flag.";


CM_ BO_ 1583 "HCU software version fields, bit-packed. Three fields not in SG_ (cross-byte): HCU_SwIDMaturity_Enum=(B0[0]<<1)|(B1>>7) 2-bit; HCU_SwIDVehVariant_Enum=(B3<<2)|(B4>>6) 10-bit; HCU_SwIDCalVer_Cnt=(B4[5:0]<<2)|(B5>>6) 8-bit.";


CM_ BO_ 1594 "Vehicle configuration flags -- charger type and ESS pack type.";

